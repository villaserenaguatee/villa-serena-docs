  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "engines": { "node": "24.x" },
  "scripts": {
    "contract:info": "node scripts/contrato-api.mjs info",
    "contract:validate": "node scripts/contrato-api.mjs validate",
